---
// The glass highlight for a screen drawn in SVG (light.css has the HTML screens'): a soft diagonal white
// gradient at low opacity, bright at the top left and gone by two thirds of the way across. It is the last
// thing drawn in the screen's <svg>, so it lies over the content. The gradient's id is unique per instance:
// the experience objects are rendered twice (the stage and the block).
import { glassId } from './glassId'

interface Props {
  x: number | string
  y: number | string
  width: number | string
  height: number | string
  rx?: number | string
}
const { x, y, width, height, rx = 0 } = Astro.props
const id = glassId()
---

<linearGradient id={id} x1="0" y1="0" x2="1" y2="0.6">
  <stop offset="0" stop-color="#fff" stop-opacity="0.22"></stop>
  <stop offset="0.36" stop-color="#fff" stop-opacity="0.07"></stop>
  <stop offset="0.64" stop-color="#fff" stop-opacity="0"></stop>
</linearGradient>
<rect class="glass-rect" x={x} y={y} width={width} height={height} rx={rx} fill={`url(#${id})`} pointer-events="none"></rect>
