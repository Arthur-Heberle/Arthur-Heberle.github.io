---
// Agente H's "The dashboard": the owner's side, in one paragraph (Arthur's copy, verbatim) and
// three screenshots of the real dashboard (backend/static of the AGENT-H repo, unmodified) served
// with DEMO data only: the repo's own sample catalogue (catalogo_moveis.csv) and invented
// conversations and leads, with phone numbers whose area code "00" does not exist. No real phone
// number, name or message appears in them. The English interface is the dashboard's own.
// 1280x800, so the boxes are sized before the images load.
import { getLang } from '../../shared/i18n/lang'
import { text } from './text'

const t = text[getLang(Astro)].dashboard
const SHOTS = [
  { src: '/agente-h/dashboard-catalogue.webp', alt: t.shots[0] },
  { src: '/agente-h/dashboard-conversations.webp', alt: t.shots[1] },
  { src: '/agente-h/dashboard-leads.webp', alt: t.shots[2] },
]
---

<section class="flex flex-col gap-3" aria-labelledby="dashboard-heading">
  <h2 id="dashboard-heading" class="text-h3 font-sans font-medium" data-anim>{t.heading}</h2>
  <p class="measure text-body" data-anim data-delay="0.06">
    {t.text}
  </p>
  <div class="shots">
    {
      SHOTS.map((s) => (
        <img class="shot" src={s.src} alt={s.alt} width="1280" height="800" loading="lazy" decoding="async" />
      ))
    }
  </div>
</section>
