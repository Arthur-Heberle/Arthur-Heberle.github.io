---
// The project page template — design-spec.md §6, "one per set-piece project". Order: title and
// intro (with an optional margin note), the set-piece (default slot), the `after` slot (a
// project's own sections: EduBra's "How it works" story and "By the numbers"), "How we built
// it" (optional), "My part", "What I'd do differently", Links. The set-piece sits in the header
// group, tight under the intro.
//
// One <article>, not several sibling <section>s like the home page — a project page is
// one self-contained document, not a set of independent page sections. type.css extends
// its `.page-main > section` positioning rule to `article` for this file's own Tick.
//
// Prose comes from the archive entry's `project` field (src/content.config.ts). It's
// required for any entry this template renders — src/pages/projects/[slug].astro only
// builds a page for an id in PROJECT_PAGES, and giving an entry a page without giving it
// `project` data is a content mistake, not a state to degrade gracefully from (same
// stance as braille.ts throwing on an unmapped letter). An unresolved [FILL] value inside
// `project` still renders correctly — Fill.astro's policy is unchanged.
import type { CollectionEntry } from 'astro:content'
import Fill from '../shared/components/Fill.astro'
import { getCollection } from 'astro:content'
import OriginLink from './OriginLink.astro'
import TitleBlock from './TitleBlock.astro'
import { sortArchive } from '../home/archive/sortArchive'
import { hasProjectPage, projectPageHref } from './projects'
import MarginNote from '../home/spine/MarginNote.astro'
import Tick from '../shared/components/Tick.astro'

interface Props {
  entry: CollectionEntry<'archive'>
}
const { entry } = Astro.props
const { title, links, project } = entry.data

if (!project) {
  throw new Error(
    `ProjectPage: "${entry.id}" has no \`project\` field — add one to its archive frontmatter before giving it a project page.`,
  )
}

const hasLinks = Boolean(links.repo || links.live || project.paper)

// The title block: this project's place in the home archive's own order, and the next entry
// if it has a project page of its own. "Project name" is the title before its dash.
const sorted = sortArchive(await getCollection('archive'))
const at = sorted.findIndex((e) => e.id === entry.id)
const nameOf = (t: string) => t.split(' — ')[0]
const following = sorted[at + 1]
const next =
  following && hasProjectPage(following.id)
    ? { sheet: at + 2, href: projectPageHref(following.id), name: nameOf(following.data.title) }
    : undefined
---

<article class="flex flex-col gap-16 py-16">
  <Tick />

  <!-- the way back: first in the page, not revealed by motion -->
  <OriginLink />

  <div class="flex flex-col gap-4">
    <h1 id="project-heading" class="text-h2 font-sans font-medium" data-anim>{title}</h1>
    {
      project.note ? (
        // the home page's rail: prose, gutter (where the leader is drawn), margin
        <div class="rail" data-anim-scope>
          <p class="rail-prose text-body" data-anim data-delay="0.06">
            <Fill value={project.what} />
          </p>
          <div class="rail-margin flex flex-col">
            <MarginNote>{project.note}</MarginNote>
          </div>
        </div>
      ) : (
        <p class="measure text-body" data-anim data-delay="0.06">
          <Fill value={project.what} />
        </p>
      )
    }
    <slot />
  </div>

  <slot name="after" />

  {
    project.built && (
      <section class="flex flex-col gap-3" aria-labelledby="project-built-heading">
        <h2 id="project-built-heading" class="text-h3 font-sans font-medium" data-anim>
          How we built it
        </h2>
        {project.built.map((text, i) => (
          <p class="measure text-body" data-anim data-delay={i === 0 ? '0.06' : undefined}>
            <Fill value={text} />
          </p>
        ))}
      </section>
    )
  }

  <section class="flex flex-col gap-3" aria-labelledby="project-part-heading">
    <h2 id="project-part-heading" class="text-h3 font-sans font-medium" data-anim>My part</h2>
    {
      project.part.map((text, i) => (
        <p class="measure text-body" data-anim data-delay={i === 0 ? '0.06' : undefined}>
          <Fill value={text} />
        </p>
      ))
    }
  </section>

  <section class="flex flex-col gap-3" aria-labelledby="project-differently-heading">
    <h2 id="project-differently-heading" class="text-h3 font-sans font-medium" data-anim>
      What I'd do differently
    </h2>
    {
      project.differently.map((text, i) => (
        <p class="measure text-body" data-anim data-delay={i === 0 ? '0.06' : undefined}>
          <Fill value={text} />
        </p>
      ))
    }
  </section>

  {
    hasLinks && (
      <section class="flex flex-col gap-3" aria-labelledby="project-links-heading">
        <h2 id="project-links-heading" class="text-h3 font-sans font-medium" data-anim>
          Links
        </h2>
        <p class="flex flex-wrap gap-x-gutter gap-y-2 text-small" data-anim data-delay="0.06">
          {links.repo && (
            <a class="feedback" href={links.repo}>
              Code on GitHub
            </a>
          )}
          {links.live && (
            <a class="feedback" href={links.live}>
              live
            </a>
          )}
          {project.paper && (
            <a class="feedback" href={project.paper.href}>
              {project.paper.label}
            </a>
          )}
        </p>
      </section>
    )
  }
  <TitleBlock name={nameOf(title)} sheet={at + 1} total={sorted.length} next={next} />
</article>
