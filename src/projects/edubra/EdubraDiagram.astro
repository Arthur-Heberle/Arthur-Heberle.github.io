---
// EduBra's system diagram — static, in the drawing's own language: square boxes, 1px
// non-scaling hairlines, sans labels, no fill. Added by Arthur on 2026-09-29
// (design-spec.md §6). It shows how the device is wired, which the Braille set-piece above it
// doesn't: file → web page → Wi-Fi → Raspberry Pi 4 → six servos and a speaker, with the
// four buttons and the volume knob as inputs to the Pi. Every box is traceable to the
// Oficinas_1 repo (app.py, pi_receiver.py).
//
// Two drawings of the same system, one per layout: a horizontal one at >=768px, where the
// column is wide enough to keep labels at ~18px, and a vertical one below it, where a
// horizontal drawing scaled to 343px would shrink the labels to ~9px. Only one is displayed
// at a time (type.css), and display:none takes the other out of the accessibility tree
// too, so a screen reader hears one title and one description.
//
// Not animated. The wrapper carries data-anim, so it arrives with the same tier-2 reveal as
// every other block on the page.
const desc =
  'A text file is uploaded to a web page, which sends the text over Wi-Fi to a Raspberry Pi 4. The Pi drives six servos and a speaker, and reads four buttons and a volume knob as inputs.'
---

<figure class="edubra-diagram" data-anim>
  <svg
    class="edubra-diagram-wide"
    viewBox="0 0 680 250"
    role="img"
    aria-labelledby="edubra-diagram-title-wide edubra-diagram-desc-wide"
  >
    <title id="edubra-diagram-title-wide">EduBra system diagram</title>
    <desc id="edubra-diagram-desc-wide">{desc}</desc>
    <defs>
      <marker id="edubra-arrow-wide" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--color-graphite-2)" />
      </marker>
    </defs>
    <g class="edubra-boxes">
      <rect x="0.5" y="140" width="70" height="50" />
      <rect x="110" y="140" width="110" height="50" />
      <rect x="310" y="125" width="200" height="80" />
      <rect x="290" y="20" width="140" height="50" />
      <rect x="445" y="20" width="130" height="50" />
      <rect x="560" y="100" width="119.5" height="50" />
      <rect x="560" y="180" width="119.5" height="50" />
    </g>
    <g class="edubra-links">
      <path d="M70 165 H110" marker-end="url(#edubra-arrow-wide)" />
      <path d="M220 165 H310" marker-end="url(#edubra-arrow-wide)" />
      <path d="M360 70 V125" marker-end="url(#edubra-arrow-wide)" />
      <path d="M480 70 V125" marker-end="url(#edubra-arrow-wide)" />
      <path d="M510 150 H535 V125 H560" marker-end="url(#edubra-arrow-wide)" />
      <path d="M510 180 H535 V205 H560" marker-end="url(#edubra-arrow-wide)" />
    </g>
    <g class="edubra-labels">
      <text x="35" y="171">File</text>
      <text x="165" y="171">Web page</text>
      <text x="265" y="154" class="edubra-note">Wi-Fi</text>
      <text x="410" y="171">Raspberry Pi 4</text>
      <text x="360" y="51">Four buttons</text>
      <text x="510" y="51">Volume knob</text>
      <text x="620" y="131">Six servos</text>
      <text x="620" y="211">Speaker</text>
    </g>
  </svg>

  <svg
    class="edubra-diagram-tall"
    viewBox="0 0 340 450"
    role="img"
    aria-labelledby="edubra-diagram-title-tall edubra-diagram-desc-tall"
  >
    <title id="edubra-diagram-title-tall">EduBra system diagram</title>
    <desc id="edubra-diagram-desc-tall">{desc}</desc>
    <defs>
      <marker id="edubra-arrow-tall" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--color-graphite-2)" />
      </marker>
    </defs>
    <g class="edubra-boxes">
      <rect x="120" y="0.5" width="100" height="44" />
      <rect x="105" y="80" width="130" height="44" />
      <rect x="0.5" y="194" width="140" height="44" />
      <rect x="199.5" y="194" width="140" height="44" />
      <rect x="80" y="290" width="180" height="50" />
      <rect x="0.5" y="400" width="140" height="44" />
      <rect x="199.5" y="400" width="140" height="44" />
    </g>
    <g class="edubra-links">
      <path d="M170 44 V80" marker-end="url(#edubra-arrow-tall)" />
      <path d="M170 124 V290" marker-end="url(#edubra-arrow-tall)" />
      <path d="M70 238 V315 H80" marker-end="url(#edubra-arrow-tall)" />
      <path d="M270 238 V315 H260" marker-end="url(#edubra-arrow-tall)" />
      <path d="M140 340 V370 H70 V400" marker-end="url(#edubra-arrow-tall)" />
      <path d="M200 340 V370 H270 V400" marker-end="url(#edubra-arrow-tall)" />
    </g>
    <g class="edubra-labels">
      <text x="170" y="28">File</text>
      <text x="170" y="108">Web page</text>
      <text x="162" y="165" class="edubra-note edubra-end">Wi-Fi</text>
      <text x="70" y="222">Four buttons</text>
      <text x="270" y="222">Volume knob</text>
      <text x="170" y="321">Raspberry Pi 4</text>
      <text x="70" y="428">Six servos</text>
      <text x="270" y="428">Speaker</text>
    </g>
  </svg>
</figure>
