---
// Spine — the paragraph carrying the through-line. Copy is verbatim from
// Arthur's brief of 2026-10-01. Page copy, not a collection; the two margin notes it points to are
// the `notes` collection, keyed here by label rather than by file order.
//
// The markers are callout balloons (an 18px ring and its number, like a technical drawing's).
// From 768px up spine.ts places each note beside its marker's line and draws a leader from the
// balloon in the text to the one that starts its note; below that, or without JavaScript, the
// notes follow their paragraph in the flow and each balloon is still a real link to its note.
import { getCollection } from 'astro:content'
import MarginNote from './MarginNote.astro'
import Tick from '../../shared/components/Tick.astro'

const notes = await getCollection('notes')
const byLabel = Object.fromEntries(notes.map((note) => [note.data.label, note]))
---

<section class="flex flex-col pb-16 pt-8" aria-label="About">
  <Tick />
  <noscript><style>.rail-spine .rail-margin { height: auto }</style></noscript>
  <div class="rail rail-spine" data-anim-scope data-spine>
    <svg class="spine-leaders" aria-hidden="true"></svg>
    <p class="rail-prose rail-prose-1 text-body" data-anim>
      I build things that sit between software and the physical world. A device that
      turns digital text into Braille. A WhatsApp agent that sells from a shop's own
      catalogue. A 2D platformer in C++. The part I'm best at is the handover: getting
      the thing understood by the people who have to use it, sign it off, or pay for
      it.<a
        class="balloon"
        id="marker-reading"
        href="#note-reading"
        aria-label="note 1, reading"
        aria-describedby="note-text-reading">1</a
      > And I build my own projects when nobody asked me to.<a
        class="balloon"
        id="marker-working-on"
        href="#note-working-on"
        aria-label="note 2, working on"
        aria-describedby="note-text-working-on">2</a
      >
    </p>
    <div class="rail-margin rail-margin-a flex flex-col">
      <MarginNote entry={byLabel['reading']} marker={1} sibling={0} />
      <MarginNote entry={byLabel['working on']} marker={2} sibling={1} />
    </div>
  </div>
</section>

<script>
  import { initSpine } from './spine'
  initSpine()
</script>
