---
// Spine — the paragraph carrying the through-line. Copy is verbatim from Arthur's brief of 2026-10-01.
// Its two margin notes were removed (home refactor, stage 1, 2026-11-16); the
// paragraph stays on columns 1 to 7 of the home grid until stage 3 decides its fate.
import { getLang } from '../../shared/i18n/lang'
import { text } from './text'

const t = text[getLang(Astro)]
---

<section class="flex flex-col pb-16 pt-8" aria-label={t.about}>
  <div class="rail rail-spine" data-anim-scope>
    <p class="rail-prose rail-prose-1 text-body" data-anim>{t.prose}</p>
  </div>
</section>
