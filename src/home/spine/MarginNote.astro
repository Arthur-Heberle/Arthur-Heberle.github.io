---
// A plain margin note: the slot's text, no label and no marker (a project page's single note beside
// its intro, where a "1" would imply a sequence). Its drawn leader runs into the rail's gutter;
// motion.ts's tier1Leaders scrubs it. Revealed 200ms behind its paragraph (docs/motion-spec.md).
---

<aside class="note" data-anim data-delay="0.20">
  <svg class="leader" viewBox="0 0 32 24" preserveAspectRatio="none" aria-hidden="true">
    <path
      class="leader-base"
      d="M0 4 H18 L32 12"
      fill="none"
      stroke="var(--color-line)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"></path>
    <path
      class="leader-hi"
      d="M0 4 H18 L32 12"
      fill="none"
      stroke="var(--color-signal)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"></path>
  </svg>
  <div class="note-text text-small text-graphite-2">
    <slot />
  </div>
</aside>
