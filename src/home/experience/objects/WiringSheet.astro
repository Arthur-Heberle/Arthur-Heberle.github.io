---
// ELETRON: a folded wiring diagram (the multi-line diagram the electrical panels were assembled from): a
// sheet creased in three, with a few ruled lines and symbols.
import Cub from '../../../projects/edubra/Cub.astro'
---

<div class="ws-place">
  <Cub x={0} y={0} w={54} d={40} h={1} cls="xp-paper">
    <svg viewBox="0 0 54 40" width="100%" height="100%" focusable="false">
      <path class="ws-fold" d="M18 0 V40 M36 0 V40"></path>
      <path class="ws-ln" d="M4 8 H50 M4 15 H50 M4 22 H50"></path>
      <path class="ws-ln" d="M12 8 V30 M27 15 V34 M42 8 V28"></path>
      <rect class="ws-sym" x="9" y="26" width="6" height="4"></rect>
      <rect class="ws-sym" x="24" y="30" width="6" height="4"></rect>
      <rect class="ws-sym" x="39" y="24" width="6" height="4"></rect>
    </svg>
  </Cub>
</div>
