---
// A generic FDM printer (no real brand's shape or logo), like a common bed-slinger: a frame, a bed that moves
// front to back, two posts with a gantry bar that rises with the layers, and a print head that slides along the
// bar. It prints a small part in six layers, each filled with parallel lines at its own angle. The lines are
// generated here in the part's own coordinates and clipped to the part, so the filling cannot fall outside it.
// Action (experience.ts, driven by Monitor): per layer the gantry steps up and the layer appears; then for every
// line the head slides in x and the bed in y, so the nozzle traces the line while it is drawn.
import Cub from '../../../projects/edubra/Cub.astro'

const PW = 36 // the part, in the bed's coordinates: x 17, y 14
const PD = 24
const PX = 17
const PY = 14
const S = 5 // line spacing
const ANGLES = [0, 60, 120, 30, 90, 150]
const M = 1 // margin kept inside the part's edge

/** Parallel lines at `deg`, clipped to the part and joined in alternating directions, as [x1, y1, x2, y2]. */
function infill(deg: number) {
  const a = (deg * Math.PI) / 180
  const dx = Math.cos(a)
  const dy = Math.sin(a)
  const cx = PW / 2
  const cy = PD / 2
  const R = Math.hypot(PW, PD) / 2
  const out: [number, number, number, number][] = []
  for (let o = -Math.floor(R / S) * S; o <= R; o += S) {
    const px = cx - dy * o
    const py = cy + dx * o
    let t0 = -1e9
    let t1 = 1e9
    let ok = true
    for (const [p, d, lo, hi] of [
      [px, dx, M, PW - M],
      [py, dy, M, PD - M],
    ]) {
      if (Math.abs(d) < 1e-9) {
        if (p < lo || p > hi) ok = false
      } else {
        const ta = (lo - p) / d
        const tb = (hi - p) / d
        t0 = Math.max(t0, Math.min(ta, tb))
        t1 = Math.min(t1, Math.max(ta, tb))
      }
    }
    if (!ok || t1 - t0 < 1) continue
    const line: [number, number, number, number] = [px + dx * t0, py + dy * t0, px + dx * t1, py + dy * t1]
    out.push(out.length % 2 ? [line[2], line[3], line[0], line[1]] : line)
  }
  return out
}
const layers = ANGLES.map(infill)
const f = (n: number) => n.toFixed(2)
---

<div class="pr-wrap">
  <Cub x={0} y={0} w={100} d={90} h={8} cls="xp-black">
    <div class="pr-bm">
      <Cub x={15} y={16} w={70} d={56} h={2} cls="xp-bed">
        <Cub x={2} y={2} w={66} d={52} h={0.2} cls="xp-black" />
        {
          layers.map((lines, i) => (
            <div class="pr-layer" data-i={i} style={`transform:translateZ(${i * 3 + 0.2}px)`}>
              <div class="pr-pop" style={`transform-origin:${PX + PW / 2}px ${PY + PD / 2}px`}>
                <Cub x={PX} y={PY} w={PW} d={PD} h={3} cls="xp-part">
                  <svg viewBox={`0 0 ${PW} ${PD}`} width="100%" height="100%" focusable="false">
                    {lines.map(([x1, y1, x2, y2]) => (
                      <path class="pr-fill" d={`M${f(x1)} ${f(y1)} L${f(x2)} ${f(y2)}`} data-x1={f(x1)} data-y1={f(y1)} data-x2={f(x2)} data-y2={f(y2)} />
                    ))}
                  </svg>
                </Cub>
              </div>
            </div>
          ))
        }
      </Cub>
    </div>
    <Cub x={4} y={39} w={6} d={6} h={56} cls="xp-black" />
    <Cub x={90} y={39} w={6} d={6} h={56} cls="xp-black" />
    <Cub x={86} y={8} w={4} d={4} h={34} cls="xp-black" />
    <div class="pr-up" style="transform:translateZ(26px)">
      <Cub x={80} y={5} w={16} d={9} h={16} cls="xp-spool" />
    </div>
    <Cub x={34} y={78} w={32} d={10} h={12} cls="xp-black">
      <svg slot="front" viewBox="0 0 32 12" width="100%" height="100%" focusable="false">
        <rect class="pr-scr" x="3" y="2" width="15" height="8" rx="1" />
        <circle class="pr-knob" cx="25" cy="6" r="3" />
      </svg>
    </Cub>
    <div class="pr-gantry">
      <Cub x={10} y={39} w={80} d={6} h={6} cls="xp-black">
        <Cub x={3} y={1.2} w={74} d={1.2} h={0.8} cls="xp-cable" />
      </Cub>
      <div class="pr-head">
        <Cub x={42} y={37} w={16} d={10} h={12} cls="xp-blackhead" />
        <div class="pr-noz"><Cub x={48.5} y={40.5} w={3} d={3} h={5} cls="xp-nozzle" /></div>
      </div>
    </div>
  </Cub>
</div>
