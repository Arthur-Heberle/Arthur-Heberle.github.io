---
// ELETRON: a power analyzer modelled on the IMS PowerNET T-500, with no logo: a black rectangular enclosure
// with screws at the corners, a two-line green backlit LCD and a square green DISPLAY button. Its four green
// pluggable terminal blocks are separate 3D blocks that stand out of the front face, two along the top edge
// (the current inputs I1 to I3, and IN1 to IN5) and two along the bottom edge (the voltage inputs +V1- to +V3-,
// and GND, RL1, RL2, VAUX), with their wire holes facing the viewer and their screw heads on top. Three
// cables, L1 to L3 (brown, black, grey), are real 3D cylinders running across above the analyzer; a split-core
// current transformer clamps each one, with a lead down to I1 to I3. Voltage leads leave +V1- to +V3-.
// The readings are illustrative. Beside it lie a clipboard with a spreadsheet and a printed report, and the
// before/after chart is drawn 2D. Action (experience.ts): the transformers close around the cables, current
// pulses travel along L1 to L3 (a third of a pass apart, like three phases), the DISPLAY button presses and
// the LCD cycles through four readings, then the chart draws and the savings area fills.
//
// Everything is placed in SCREEN x, left to right as it reads (the plane is mirrored, so a box's plane x is
// W - screen x - its width): `px()` does that conversion.
import Cub from '../../../projects/edubra/Cub.astro'
import Cable from './Cable.astro'
import MeterChart from './MeterChart.astro'
import Clipboard from './Clipboard.astro'
import Report from './Report.astro'

const W = 210
const H = 104
const D = 22
const BX = 45 // the body's place on the plane
const BY = 8
const px = (sx: number, w = 0) => W - sx - w
const OUT = 12 // how far the terminal blocks stand out of the front face
const TH = 14 // a block's height

// terminal blocks: [screen x of the block's left edge, width, centres (screen x), labels]
const pitch = (x0: number, w: number, n: number) => Array.from({ length: n }, (_, i) => x0 + (w / n) * (i + 0.5))
const blocks = {
  top: [
    { x: 16, w: 84, c: pitch(16, 84, 3), l: ['I1', 'I2', 'I3'] },
    { x: 112, w: 84, c: pitch(112, 84, 5), l: ['IN1', 'IN2', 'IN3', 'IN4', 'IN5'] },
  ],
  bottom: [
    { x: 16, w: 84, c: pitch(16, 84, 3), l: ['+V1-', '+V2-', '+V3-'] },
    { x: 112, w: 84, c: pitch(112, 84, 4), l: ['GND', 'RL1', 'RL2', 'VAUX'] },
  ],
}
const TOP_Z = H - 20 // a block's base height off the desk
const BOT_Z = 6

// the three cables: heights above the top face, depths on it, insulation colours (three-phase convention)
const cables = [
  { id: 'L1', z: 14, y: 31, c: blocks.top[0].c[0], cls: 'cy-l1' },
  { id: 'L2', z: 26, y: 27, c: blocks.top[0].c[1], cls: 'cy-l2' },
  { id: 'L3', z: 38, y: 23, c: blocks.top[0].c[2], cls: 'cy-l3' },
]
const C0 = -22 // the cables run from here to here, in screen x
const C1 = 232
const CT = 16 // the transformer clamp: along the cable, across it, and each half's height
const CTD = 12
const CTH = 7
const PULSE = 8
const readings = [
  ['VOLTAGE', 'V1 220.4 V'],
  ['CURRENT', 'I1 18.2 A'],
  ['POWER', 'P 11.9 kW'],
  ['ENERGY', 'E 1284 kWh'],
]
const screws = [
  [4, 4],
  [W - 4, 4],
  [4, H - 4],
  [W - 4, H - 4],
]
---

<div class="xp-scene" style="--m:1.42;--fw:300px;--fd:190px;--dx:12px;--dy:50px">
  <div class="xp-plane">
    <div class="xp-lift">
      <div class="an-pose xp-turn" style={`left:${BX}px;top:${BY}px;width:${W}px;height:${D}px`}>
        <Cub x={0} y={0} w={W} d={D} h={H} cls="xp-an">
          <svg slot="front" class="an-svg" viewBox={`0 0 ${W} ${H}`} width="100%" height="100%" focusable="false">
            {
              screws.map(([x, y]) => (
                <g class="an-screw">
                  <circle cx={x} cy={y} r="2.2" />
                  <path d={`M${x - 1.4} ${y - 1.4} L${x + 1.4} ${y + 1.4}`} />
                </g>
              ))
            }
            <rect class="an-lcd" x="44" y="40" width="96" height="30" rx="2" />
            {
              readings.map(([a, b], i) => (
                <g class="an-r" data-i={i}>
                  <text class="an-r1" x="50" y="51">{a}</text>
                  <text class="an-r2" x="50" y="63">{b}</text>
                </g>
              ))
            }
            <g class="an-btn"><rect x="152" y="44" width="20" height="20" rx="1.5" /></g>
            <text class="an-pl" x="162" y="73" text-anchor="middle">DISPLAY</text>
            <rect class="an-usb" x="16" y="46" width="18" height="11" rx="1.5" />
            <text class="an-pl" x="25" y="66" text-anchor="middle">USB</text>
          </svg>
          {
            /* the terminal blocks: pluggable, green, standing out of the front face */
            (['top', 'bottom'] as const).map((edge) => (
              <div class="an-blocks" style={`transform:translateZ(${(edge === 'top' ? TOP_Z : BOT_Z) - H}px)`}>
                {blocks[edge].map((b) => (
                  <Cub x={px(b.x, b.w)} y={D} w={b.w} d={OUT} h={TH} cls="xp-tb">
                    <svg slot="front" viewBox={`0 0 ${b.w} ${TH}`} width="100%" height="100%" focusable="false">
                      {b.c.map((c) => <rect class="tb-hole" x={c - b.x - 3.4} y="5.6" width="6.8" height="6.4" rx="0.8" />)}
                      {b.c.map((c, i) => <text class="tb-pl" x={c - b.x} y="4.1" text-anchor="middle">{b.l[i]}</text>)}
                      {b.c.slice(1).map((c) => <path class="tb-sep" d={`M${c - b.x - b.w / b.c.length / 2} 0 V${TH}`} />)}
                    </svg>
                    <svg viewBox={`0 0 ${b.w} ${OUT}`} width="100%" height="100%" focusable="false">
                      {b.c.map((c) => (
                        <g class="tb-screw">
                          <circle cx={c - b.x} cy={OUT / 2} r="3.4" />
                          <path d={`M${c - b.x - 2} ${OUT / 2 - 2} L${c - b.x + 2} ${OUT / 2 + 2}`} />
                        </g>
                      ))}
                      {b.c.slice(1).map((c) => <path class="tb-sep" d={`M${c - b.x - b.w / b.c.length / 2} 0 V${OUT}`} />)}
                    </svg>
                  </Cub>
                ))}
              </div>
            ))
          }
          <Fragment>
            {
              cables.map((k) => (
                <div class="an-cable" data-cable={k.id} style={`left:${px(C1)}px;top:${k.y}px;transform:translateZ(${k.z}px)`}>
                  <Cable len={C1 - C0} r={3} cls={k.cls} />
                  <Cable len={PULSE} r={3.9} cls="cy-pulse" />
                  <Cable len={PULSE} r={3.9} cls="cy-pulse" />
                  <span class="cy-tag">{k.id}</span>
                </div>
              ))
            }
            {
              /* the current transformers: a base, a hinged lid, and a lead down to I1 to I3 */
              cables.map((k) => (
                <div class="an-ct" style={`left:${px(k.c, CT / 2)}px;top:${k.y - CTD / 2}px;transform:translateZ(${k.z - CTH}px)`}>
                  <Cub x={0} y={0} w={CT} d={CTD} h={CTH} cls="xp-ct" />
                  <div class="an-lid" style={`transform:translateZ(${CTH}px)`}>
                    <div class="an-lidrot" data-ct={k.id}>
                      <Cub x={0} y={0} w={CT} d={CTD} h={CTH} cls="xp-ct xp-ct-lid" />
                    </div>
                  </div>
                  <div class="an-lead" style={`left:${CT / 2 - 0.8}px;top:${CTD / 2 - 0.8}px;transform:translateZ(${-(k.z - CTH) + (TOP_Z + TH - H)}px)`}>
                    <Cub x={0} y={0} w={1.6} d={1.6} h={k.z - CTH - (TOP_Z + TH - H)} cls="xp-lead" />
                  </div>
                </div>
              ))
            }
          </Fragment>
        </Cub>
      </div>
      <Clipboard />
      <Report />
    </div>
  </div>
  <MeterChart />
</div>
