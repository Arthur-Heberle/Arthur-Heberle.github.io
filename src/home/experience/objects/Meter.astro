---
// ELETRON: an energy meter, a box with a small display. Action (timeline.ts): the display counts up kWh.
// MeterChart.astro is its 2D companion, drawn beside it (not on the plane). The reading is illustrative.
import Cub from '../../../projects/edubra/Cub.astro'
---

<Cub x={7} y={5} w={50} d={24} h={52} cls="xp-meter xp-turn">
  <div slot="front" class="mt-face">
    <div class="mt-lcd"><b data-kwh>128.4</b><i>kWh</i></div>
    <div class="mt-dial"></div>
    <div class="mt-terms"><u></u><u></u><u></u></div>
  </div>
</Cub>
