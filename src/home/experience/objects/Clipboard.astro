---
// ELETRON: a clipboard lying flat, holding a sheet with a spreadsheet grid (the measurement-and-verification
// model). No numbers: it is a drawing of a table.
import Cub from '../../../projects/edubra/Cub.astro'
const rows = 7
const cols = 4
---

<div class="cb-place">
  <Cub x={0} y={0} w={48} d={64} h={1.6} cls="xp-clip">
    <svg viewBox="0 0 48 64" width="100%" height="100%" focusable="false">
      <rect class="cb-sheet" x="4" y="9" width="40" height="52"></rect>
      <rect class="cb-clip" x="15" y="2" width="18" height="9" rx="1.5"></rect>
      <rect class="cb-head" x="6" y="14" width="36" height="5"></rect>
      {Array.from({ length: rows }, (_, r) => <path class="cb-ln" d={`M6 ${14 + 5 * r + 5} H42`} />)}
      {Array.from({ length: cols - 1 }, (_, c) => <path class="cb-ln" d={`M${6 + 9 * (c + 1)} 14 V49`} />)}
      <path class="cb-chart" d="M8 58 L16 54 L24 56 L32 52 L40 53"></path>
    </svg>
  </Cub>
</div>
