---
// Experience, newest first. From 900px up (with JavaScript) two columns: on the left a stage that is
// position: sticky and shows one experience's object at a time, with a small timeline at its top; on the
// right the four experiences as normal-flow text blocks, each at least 80vh tall. The page always scrolls
// normally: nothing is pinned or hijacked. experience.ts (a separate chunk, fetched when the section nears
// the viewport) makes the block in the middle of the viewport the active one, which brings its object onto
// the stage and plays its action the first time. Below 900px, and without JavaScript, there is no stage:
// each block stands on its own with a bar for its period, its object and its details.
//
// The collection is the only source of text. Objects, the stage's timeline and the mini bars are drawings
// (aria-hidden or role="img" with one description); the accessibility tree holds the headings with their
// text, the timeline links and one description per visible object. Optional fields are omitted when missing
// or still a [FILL] (src/shared/fill.ts).
import { getCollection } from 'astro:content'
import Tick from '../../shared/components/Tick.astro'
import { isFilled } from '../../shared/fill'
import { layout, monthOf, months } from './months'
import Chalkboard from './objects/Chalkboard.astro'
import Analyzer from './objects/Analyzer.astro'
import Laptop from './objects/Laptop.astro'
import Monitor from './objects/Monitor.astro'

const entries = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start))
const now = monthOf(new Date())
const { spans, ticks, pct } = layout(
  entries.map((e) => e.data),
  now,
)
const yearAt = pct(12) // where 2026 starts on the axis

// Each experience's object, and the one description that names it for assistive technology (the drawing
// itself is aria-hidden). The RP3, laptop and analyzer descriptions say what is illustrative.
const OBJECTS: Record<string, { Object: any; desc: string }> = {
  rp3: {
    Object: Monitor,
    desc: "An illustration, not RP3's real interface: a monitor showing a part sliced into layers on a gridded build platform with X, Y and Z axes, the layer contours rising one layer at a time, and beside it a small generic 3D printer building the same part layer by layer.",
  },
  'programming-techniques': {
    Object: Laptop,
    desc: "A laptop showing a class diagram: Entity, with Player and Enemy inheriting from it, and a Level holding a pointer to an Entity, above a few lines of C++. The class names and code are illustrative of the course's SFML game, not its real code.",
  },
  'eletron-energia': {
    Object: Analyzer,
    desc: 'An illustration of a power analyzer in the style of the IMS PowerNET T-500, with green terminal blocks standing out of its front, and three current transformers clamped around cables L1 to L3, current pulsing through them, wired to its inputs, its display cycling through illustrative readings; beside it a clipboard with a spreadsheet, a printed measurement-and-verification report, and a chart of consumption before and after with the savings between the two. The readings and figures are illustrative, not measured values.',
  },
  'calculus-ii': {
    Object: Chalkboard,
    desc: 'A chalkboard in a wooden frame, written in chalk with Calculus II on one half (a curve with the area under it hatched, integration by parts, the Taylor series of e to the x, a series sum) and Calculus III on the other (the surface z equals x squared plus y squared, the gradient, a double integral and a line integral).',
  },
}

// "2026-07" displays as "2026.07" (design-spec.md §7).
const show = (month: string) => month.replace('-', '.')
// "Programming Techniques — academic monitor" -> "Programming Techniques"
const shortName = (title: string) => title.split(' — ')[0]
const plural = (n: number) => `${n} month${n === 1 ? '' : 's'}`
---

<section class="xp" aria-labelledby="experience-heading">
  <Tick />
  <h2 id="experience-heading" class="text-h2 font-sans font-medium xp-h" data-anim>Experience</h2>
  <div class="xp-grid" data-xp>
    <!-- the stage: sticky, with JavaScript from 900px up. A small timeline, then the active experience's object. -->
    <div class="xp-stage">
      <div class="xp-tl">
        <div class="xp-axis" aria-hidden="true">
          <span class="xp-axis-line"></span>
          <svg class="xp-arrow xp-arrow-l" viewBox="0 0 10 10" width="10" height="10" focusable="false"><path d="M10 1 L1 5 L10 9" /></svg>
          {
            ticks.map((t) => (
              <span class={t.year ? 'xp-tick xp-tick-year' : 'xp-tick'} style={`left:${t.x}%`}>
                {t.year && <span class="xp-year font-mono text-dimension text-graphite-2">{t.year}</span>}
              </span>
            ))
          }
          <span class="xp-now" style="left:100%">
            <span class="xp-now-tick"></span>
            <span class="xp-now-label font-mono text-dimension text-graphite-2">now</span>
          </span>
        </div>
        <ul class="xp-lanes" role="list">
          {
            entries.map(({ id, data }, i) => {
              const span = spans[i]
              const left = span.a >= 45
              return (
                <li class="xp-lane" style={`--a:${span.a}%;--b:${span.b}%`}>
                  <a class="xp-link" href={`#xp-${id}`} data-for={id} aria-label={data.title} data-side={left ? 'left' : 'right'}>
                    <span class="xp-bar" aria-hidden="true"></span>
                    <span class="xp-name text-small" aria-hidden="true">{shortName(data.title)}</span>
                  </a>
                </li>
              )
            })
          }
        </ul>
      </div>
      <div class="xp-figs">
        {
          entries.map(({ id }, i) => {
            const o = OBJECTS[id]
            return (
              <div class="xp-fig xp-fig-stage" data-obj={id} data-state={i === 0 ? 'on' : 'before'} role="img" aria-label={o.desc}>
                <div class="xp-box" aria-hidden="true">
                  <o.Object />
                </div>
              </div>
            )
          })
        }
      </div>
    </div>

    <div class="xp-blocks">
      {
        entries.map(({ id, data }, i) => {
          const span = spans[i]
          const n = months(data.start, data.end, now)
          const o = OBJECTS[id]
          return (
            <article class="xp-block" id={`xp-${id}`} data-id={id} tabindex="-1">
              <div class="xp-inner">
                <!-- below 900px: this entry's period against a short 2025-to-now scale -->
                <div class="xp-mini" aria-hidden="true" style={`--a:${span.a}%;--b:${span.b}%`}>
                  <span class="xp-mini-line" />
                  <span class="xp-mini-tick" style="left:0" />
                  <span class="xp-mini-tick" style={`left:${yearAt}%`} />
                  <span class="xp-mini-tick" style="left:calc(100% - 1px)" />
                  <span class="xp-mini-label font-mono text-dimension text-graphite-2" style="left:0">2025</span>
                  <span class="xp-mini-label font-mono text-dimension text-graphite-2" style={`left:${yearAt}%`}>2026</span>
                  <span class="xp-mini-label font-mono text-dimension text-graphite-2" style="right:0">now</span>
                  <span class="xp-mini-bar" />
                </div>
                <div class="xp-fig xp-fig-art" data-obj={id} role="img" aria-label={o.desc}>
                  <div class="xp-box" aria-hidden="true">
                    <o.Object />
                  </div>
                </div>
                <h3 class="text-h3 font-sans font-medium">{data.title}</h3>
                <p class="xp-meta font-mono text-dimension text-graphite-2">
                  {isFilled(data.place) && <span>{data.place}</span>}
                  <span>
                    <time datetime={data.start}>{show(data.start)}</time>
                    {' – '}
                    {data.end ? <time datetime={data.end}>{show(data.end)}</time> : 'now'}
                  </span>
                  <span>{plural(n)}{data.end ? '' : ' so far'}</span>
                </p>
                {isFilled(data.role) && <p class="xp-role text-small text-graphite-2">{data.role}</p>}
                {data.text.filter(isFilled).map((p) => <p class="measure text-body">{p}</p>)}
                {data.image && (
                  <figure class="xp-shot">
                    <img src={data.image.src} width={data.image.width} height={data.image.height} alt={data.image.alt} loading="lazy" decoding="async" />
                    <figcaption class="text-small text-graphite-2">{data.image.caption}</figcaption>
                  </figure>
                )}
                {isFilled(data.hard) && (
                  <p class="xp-hard measure text-body">
                    <strong class="font-medium">The hard part:</strong> {data.hard}
                  </p>
                )}
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  // The motion is set up only when the section approaches the viewport: experience.ts is a separate
  // chunk, fetched here (the same pattern as the bench).
  const grid = document.querySelector<HTMLElement>('[data-xp]')
  if (grid) {
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        near.disconnect()
        import('./experience').then((m) => m.initExperience(grid))
      },
      { rootMargin: '400px 0px' },
    )
    near.observe(grid)
  }
</script>
