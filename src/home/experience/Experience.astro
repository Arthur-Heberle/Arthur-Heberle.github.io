---
// Experience: an ordered list (title, dates, then place, role, people, summary), oldest first, and
// from 768px up a timeline drawn over it: a dimension-line axis from 2025.01 to the current month, one
// row per entry with a bar covering its dates and its own object standing at the bar's start. The
// collection is the only source of text; the axis, bars and objects are aria-hidden drawings, so the
// accessibility tree holds the list and nothing else. Optional fields (place, role, people) are
// omitted when missing or still a [FILL] (src/shared/fill.ts).
//
// timeline.ts (a separate chunk, fetched when the section nears the viewport) plays the arrival once.
// Without it every part is in its final state.
import { getCollection } from 'astro:content'
import Tick from '../../shared/components/Tick.astro'
import { isFilled } from '../../shared/fill'
import { layout, monthOf } from './months'
import Chalkboard from './objects/Chalkboard.astro'
import Meter from './objects/Meter.astro'
import MeterChart from './objects/MeterChart.astro'
import Laptop from './objects/Laptop.astro'
import Printer from './objects/Printer.astro'

const entries = (await getCollection('experience')).sort((a, b) => a.data.start.localeCompare(b.data.start))
const { spans, ticks } = layout(
  entries.map((e) => e.data),
  monthOf(new Date()),
)

// Each experience's object: its footprint on the plane (fw by fd, in px), the object itself, and an optional
// flat 2D companion drawn beside it. `desc` is the short description the row's button points at
// (aria-describedby); the drawings themselves are aria-hidden.
const SIN = Math.sin((32 * Math.PI) / 180)
const COS = Math.cos((32 * Math.PI) / 180)
const OBJECTS: Record<string, { fw: number; fd: number; Object: any; Flat?: any; desc: string }> = {
  'calculus-ii': {
    fw: 84,
    fd: 44,
    Object: Chalkboard,
    desc: 'A small chalkboard on a stand: chalk draws a curve and an integral sign, then the area under the curve fills in.',
  },
  'eletron-energia': {
    fw: 64,
    fd: 34,
    Object: Meter,
    Flat: MeterChart,
    desc: 'An energy meter whose display counts up kWh, beside a chart of consumption before and after, with the gap between the two lines marked as savings.',
  },
  'programming-techniques': {
    fw: 120,
    fd: 56,
    Object: Laptop,
    desc: "A laptop showing a class diagram: Entity, with Player and Enemy inheriting from it, and a Level holding Entities. The class names are illustrative of the course's SFML game, not its real code.",
  },
  rp3: {
    fw: 80,
    fd: 64,
    Object: Printer,
    desc: 'A 3D printer building a part, each layer at a different angle.',
  },
}
// "2026-07" displays as "2026.07" (design-spec.md §7).
const show = (month: string) => month.replace('-', '.')
---

<section class="flex flex-col gap-8 py-16" aria-labelledby="experience-heading">
  <Tick />
  <h2 id="experience-heading" class="text-h2 font-sans font-medium" data-anim>Experience</h2>
  <div class="xp-tl" data-xp>
    <!-- the axis: a dimension line with arrowheads at both ends, year ticks (mono) and a small tick per month -->
    <div class="xp-axis" aria-hidden="true">
      <span class="xp-axis-line"></span>
      <svg class="xp-arrow xp-arrow-l" viewBox="0 0 10 10" width="10" height="10" focusable="false"><path d="M10 1 L1 5 L10 9" /></svg>
      <svg class="xp-arrow xp-arrow-r" viewBox="0 0 10 10" width="10" height="10" focusable="false"><path d="M0 1 L9 5 L0 9" /></svg>
      {
        ticks.map((t) => (
          <span class={t.year ? 'xp-tick xp-tick-year' : 'xp-tick'} style={`left:${t.x}%`}>
            {t.year && <span class="xp-year font-mono text-dimension text-graphite-2">{t.year}</span>}
          </span>
        ))
      }
    </div>
    <ol class="xp" role="list">
      {
        entries.map(({ id, data }, i) => {
          const span = spans[i]
          const side = span.b < 50 ? 'right' : 'left'
          const obj = OBJECTS[id]
          // the plane's screen box once turned 32deg: where the object's footprint ends up
          const bw = Math.round(obj.fw * COS + obj.fd * SIN)
          const bh = Math.round((obj.fw * SIN + obj.fd * COS) * 0.819)
          return (
            <li class="xp-row" data-side={side} style={`--a:${span.a}%;--b:${span.b}%`}>
              <div class="xp-track">
                <span class="xp-bar" aria-hidden="true"></span>
                {span.open && (
                  <span class="xp-open" aria-hidden="true">
                    <svg viewBox="0 0 12 16" width="12" height="16" focusable="false"><path d="M1 1 L10 8 L1 15" /></svg>
                    <span class="font-mono text-dimension text-graphite-2">now</span>
                  </span>
                )}
                <div class="xp-obj" aria-hidden="true" data-obj={id} style={`--bw:${bw}px;--bh:${bh}px;--fw:${obj.fw}px;--fd:${obj.fd}px`}>
                  <div class="xp-scene">
                    <div class="xp-plane">
                      <div class="xp-lift">
                        <obj.Object />
                      </div>
                    </div>
                  </div>
                  {obj.Flat && <obj.Flat />}
                </div>
                <div class="xp-label">
                  <h3 class="xp-title text-small font-sans font-medium">{data.title}</h3>
                  <p class="xp-dates font-mono text-dimension text-graphite-2">
                    <time datetime={data.start}>{show(data.start)}</time>
                    {' – '}
                    {data.end ? <time datetime={data.end}>{show(data.end)}</time> : 'now'}
                  </p>
                </div>
              </div>
              <div class="xp-detail">
                {isFilled(data.place) && <p class="text-small text-graphite-2">{data.place}</p>}
                {isFilled(data.role) && <p class="text-small text-graphite-2">{data.role}</p>}
                {isFilled(data.people) && <p class="text-small text-graphite-2">{data.people}</p>}
                <p class="measure text-body">{data.summary}</p>
              </div>
            </li>
          )
        })
      }
    </ol>
  </div>
</section>

<script>
  // The motion is set up only when the timeline approaches the viewport: timeline.ts is a separate
  // chunk, fetched here (the same pattern as the bench).
  const timeline = document.querySelector<HTMLElement>('[data-xp]')
  if (timeline) {
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        near.disconnect()
        import('./timeline').then((m) => m.initTimeline(timeline))
      },
      { rootMargin: '400px 0px' },
    )
    near.observe(timeline)
  }
</script>
