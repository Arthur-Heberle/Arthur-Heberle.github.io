---
// Hero — page copy, not a collection (docs/plans/step-03.md scoped the collections to
// archive/notes/changelog only). Verbatim from docs/content.md's Hero block: final, not
// provisional.
import HeroDrawing from './HeroDrawing.astro'

const identity = ['Curitiba, Brasil', 'EU citizen', 'open to global remote']
const email = 'a.gp.heberle@gmail.com'
---

<!-- relative: the hero drawing (origin mark, datum, lead) positions against this header,
     not .page-main — design-spec.md §9, docs/plans/step-12.md. -->
<header class="relative flex flex-col gap-6 pb-16 pt-12">
  <HeroDrawing />

  <div class="flex flex-wrap items-baseline justify-between gap-x-gutter gap-y-2">
    <p class="text-h3 font-sans font-medium">Arthur Gabriel Pellegrini Heberle</p>
    <!-- direct wins the tiebreak here: the real address on the first screen, not a jump
         link to a "Contact" section further down (design-spec.md §2). -->
    <a class="feedback font-mono text-small text-graphite-2 no-underline" href={`mailto:${email}`}>
      {email}
    </a>
  </div>

  <p class="flex flex-wrap gap-x-gutter gap-y-1 font-mono text-dimension text-graphite-2">
    {identity.map((item) => <span>{item}</span>)}
  </p>

  <!-- data-hero-display: the one element step 12's word-arrival sequence splits and
       animates. Read by Base.astro's flash-guard CSS and motion.ts's heroSequence(). -->
  <h1 class="display" data-hero-display>I make technical things make sense to people who didn't build them.</h1>

  <p class="measure text-body">
    Computer engineering at UTFPR, in Curitiba. Embedded systems, C++, and AI automation.
  </p>
</header>
