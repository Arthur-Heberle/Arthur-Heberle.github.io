---
// Hero (home refactor stage 3, Arthur 2026-11-16, after TODO/image.png): the photo with "Hi! I'm",
// the name and the role under it; the identity list and the intro line beside it. Centred text is
// Arthur's override of design-spec §5. The name is the page's single <h1>.
import HeroDrawing from './HeroDrawing.astro'
import { getLang } from '../../shared/i18n/lang'
import { text } from './text'

const t = text[getLang(Astro)]
---

<!-- relative: the hero drawing (origin mark, datum) positions against this header. -->
<header class="hero relative pb-8 pt-30">
  <HeroDrawing />

  <div class="hero-id">
    <!-- width/height are the file's real size; CSS crops it to 4:5, so the box is known from first paint -->
    <img
      class="hero-photo"
      src="/images/arthur-hero.jpeg"
      width="604"
      height="1073"
      alt={t.photoAlt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-hero-photo
    />
    <p class="hero-greeting text-body text-graphite-2">{t.greeting}</p>
    <!-- data-hero-display: the element motion.ts's heroSequence() splits into words, and that
         Base.astro's flash guard (hero-pending) hides until the sequence starts. -->
    <h1 class="hero-name" data-hero-display>{t.name}</h1>
    <p class="hero-role text-body text-graphite-2">{t.role}</p>
  </div>

  <div class="hero-info">
    <!-- a real list, so a screen reader doesn't read the three facts as one run-on phrase -->
    <ul role="list" class="hero-identity text-h3 font-sans">
      {t.identity.map((item) => <li>{item}</li>)}
    </ul>
    <p class="measure text-body text-graphite-2">{t.intro[0]}<br />{t.intro[1]}</p>
  </div>
</header>
