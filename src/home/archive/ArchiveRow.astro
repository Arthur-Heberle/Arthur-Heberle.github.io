---
// One archive row. `.archive-row` is the exact selector step 11's Flip snippet targets
// (docs/motion-spec.md) — defined once here, reused for both the visible rows and the
// ones inside "show all".
import type { CollectionEntry } from 'astro:content'
import { isFilled } from '../../shared/fill'
import { hasProjectPage, projectPageHref } from '../../projects/projects'

interface Props {
  entry: CollectionEntry<'archive'>
}
const { entry } = Astro.props
const { date, title, role, tags, links, blurb, wip } = entry.data
// "2026-07" displays as "2026.07" (design-spec.md §7); an unresolved [FILL] date is
// omitted from the row (src/shared/fill.ts).
const displayDate = isFilled(date) ? date.replace('-', '.') : null
const hasLinks = Boolean(links.repo || links.live || links.pdf)
// Step 13: the only entry point to a project page. hasProjectPage() reads the one list
// src/pages/projects/[slug].astro's getStaticPaths() also reads, so a linked title can
// never point at a route that doesn't exist.
const projectHref = hasProjectPage(entry.id) ? projectPageHref(entry.id) : null
---

<li class="archive-row bg-sheet px-6" data-tags={tags.join(' ')}>
  <p class="text-dimension font-mono text-graphite-2">{displayDate}</p>
  <div class="flex flex-col gap-2">
    <h3 class="text-h3 font-sans font-medium">
      {projectHref ? (
        <a class="feedback" href={projectHref}>
          {title}
        </a>
      ) : (
        title
      )}
    </h3>
    <p class="flex flex-wrap gap-x-gutter gap-y-1 text-small text-graphite-2">
      {isFilled(role) && <span>{role}</span>}
      <span>{tags.join(', ')}</span>
      {
        wip && (
          <span class="wip font-mono">
            <svg class="status-mark" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <circle cx="6" cy="6" r="4.5" />
              <path d="M6 1.5A4.5 4.5 0 0 0 6 10.5Z" />
            </svg>
            in progress
          </span>
        )
      }
    </p>
    <p class="measure text-body">{blurb}</p>
    {
      hasLinks && (
        <p class="flex gap-gutter text-small">
          {links.repo && (
            <a class="feedback" href={links.repo}>
              repo
            </a>
          )}
          {links.live && (
            <a class="feedback" href={links.live}>
              live
            </a>
          )}
          {links.pdf && (
            <a class="feedback" href={links.pdf}>
              pdf
            </a>
          )}
        </p>
      )
    }
  </div>
</li>
