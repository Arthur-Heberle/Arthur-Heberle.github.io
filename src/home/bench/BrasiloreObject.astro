---
// Brasilore on the bench: a small desk monitor in CSS 3D, in the same three-quarter view as the
// other two, with a 2D pixel scene on its screen. The sprites are Arthur's own art from the
// Brasilore repository (assets/textures: Emilia.png, Grass.png, Cloud1.png), copied to
// public/brasilore/ and drawn crisp at 1:1. At rest she stands past the gap, the final state.
---

<div class="wb-mon" data-wb="brasilore">
  <div class="mon">
    <div class="mon-body">
      <div class="mon-foot"></div>
      <div class="mon-neck"></div>
      <div class="mon-back"></div>
      <div class="mon-right"></div>
      <div class="mon-top"></div>
      <div class="mon-front">
        <div class="mon-scr">
          <img class="mon-cloud a" src="/brasilore/cloud.png" width="68" height="21" alt="" loading="lazy" decoding="async" />
          <img class="mon-cloud b" src="/brasilore/cloud.png" width="68" height="21" alt="" loading="lazy" decoding="async" />
          <div class="mon-ground left"></div>
          <div class="mon-ground right"></div>
          <img class="mon-hero" src="/brasilore/emilia.png" width="44" height="60" alt="" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</div>
