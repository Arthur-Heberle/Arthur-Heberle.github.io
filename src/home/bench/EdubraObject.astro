---
// EduBra on the bench (stacked, below 768px): the device box, scaled down, built from the project
// page's own pieces: device.css gives the MDF, the yellow PLA cell, the black pins and the yellow
// button caps (the root carries `.device`, so every rule there applies). The lid's contents are
// EdubraLid, shared with the desk's box.
import EdubraLid from './EdubraLid.astro'
---

<div class="device wb-device" data-wb="edubra">
  <div class="stage">
    <div class="box">
      <div class="lid">
        <EdubraLid />
      </div>
      <div class="front"><span class="engrave" data-text="EduBra"></span></div>
      <div class="side">
        <div class="jack"><i /></div>
      </div>
    </div>
    <div class="floor-shadow"></div>
  </div>
</div>
