---
// The Roadmap (Arthur's briefs, 2026-11-16 and 2026-11-17): one timeline per thing he is studying or building,
// read from src/content/roadmap.md (parsed by src/content/parseRoadmap.ts; the file's own comment says how to
// edit it). Each item is a rounded pill with its status (Next, Doing, Done) and its month under it; a timeline's
// sub-groups stack, each a wrapping row of pills under a small label. Nothing scrolls sideways.
//
// The line runs behind the pills: each item carries the stretch from its centre to the next item, hidden under
// the pills at both ends. Up to the timeline's last Done item the stretch is a wave (a long repeated path in a
// clipping SVG, so roadmap.ts can draw it once and ripple it with a transform); after it, a straight dotted line.
//
// A pill is a button that opens a popover with the item's text (Popover API: works without JavaScript, centred
// in the window then; roadmap.ts places it at the pill). Drawings are aria-hidden; status is in each pill's name.
import { getLang } from '../../shared/i18n/lang'
import { getRoadmap } from '../../shared/i18n/content'
import { text } from './text'
import { monthLabel } from './dates'

const lang = getLang(Astro)
const t = text[lang]
const timelines = await getRoadmap(lang)

// The wave: wavelength 24px (roadmap.ts ripples it by exactly one), 3px high, centred in a 12px-tall SVG, long
// enough (840px) to cover the widest stretch plus one wavelength.
const WAVE = `M0 6 q6 -6 12 0${' t12 0'.repeat(69)}`

const rows = timelines.map((timeline) => {
  const all = timeline.data.groups.flatMap((g) => g.items)
  const lastDone = all.map((i) => i.status).lastIndexOf('done')
  let index = 0
  const groups = timeline.data.groups.map((group, gi) => ({
    title: group.title,
    items: group.items.map((item, ii) => {
      const at = index++
      const last = ii === group.items.length - 1
      const date = item.month ? monthLabel(item.month, t.months) : undefined
      const when = date ? (item.status === 'doing' ? `${t.target} ${date}` : date) : undefined
      return {
        ...item,
        id: `rm-${timeline.id}-${gi}-${ii}`,
        date,
        when,
        // the stretch to the next item: none after a group's last item
        seg: last ? null : at < lastDone ? 'wave' : 'dots',
        label: [item.title, t.status[item.status], when].filter(Boolean).join(', '),
      }
    }),
  }))
  const done = all.filter((i) => i.status === 'done').length
  return { id: timeline.id, title: timeline.data.title, total: all.length, done, groups }
})
---

<section class="section-gap flex flex-col gap-8" aria-labelledby="roadmap-heading">
  <h2 id="roadmap-heading" class="section-title" data-anim>{t.heading}</h2>
  <div class="rm" data-roadmap>
    {
      rows.map((row) => (
        <article class="rm-timeline" aria-labelledby={`${row.id}-title`} data-rm-timeline data-anim data-delay="0.06">
          <header class="rm-head">
            <h3 id={`${row.id}-title`} class="rm-title">
              {row.title}
            </h3>
            <span class="rm-count">
              {`${row.done} ${t.of} ${row.total}`}
              <span class="sr-only">{t.doneSuffix}</span>
            </span>
            <span class="rm-bar" aria-hidden="true">
              <span class="rm-bar-fill" style={`transform:scaleX(${row.total ? row.done / row.total : 0})`} />
            </span>
          </header>
          {row.groups.map((group) => (
            <div class="rm-group">
              <p class="rm-group-label">{group.title}</p>
              <ol class="rm-items" role="list">
                {group.items.map((item) => (
                  <li class="rm-item" data-rm-item>
                    <span class="rm-pin">
                      {item.seg === 'wave' && (
                        <svg class="rm-seg" aria-hidden="true" focusable="false">
                          <path d={WAVE} pathLength="1" data-rm-wave />
                        </svg>
                      )}
                      {item.seg === 'dots' && (
                        <svg class="rm-seg" aria-hidden="true" focusable="false">
                          <line x1="1" y1="6" x2="100%" y2="6" />
                        </svg>
                      )}
                      <button
                        type="button"
                        class="rm-pill"
                        data-status={item.status}
                        popovertarget={item.id}
                        aria-label={item.label}
                      >
                        {item.status === 'done' && (
                          <span class="rm-tick" aria-hidden="true">
                            ✓
                          </span>
                        )}
                        {item.status === 'doing' && <span class="rm-dot" aria-hidden="true" />}
                        <span>{item.title}</span>
                      </button>
                    </span>
                    {item.date && <span class="rm-date font-mono">{item.date}</span>}
                    <div popover id={item.id} class="rm-pop">
                      <p class="rm-pop-title">{item.title}</p>
                      <p class="rm-pop-meta">
                        <span>{t.statusLabel[item.status]}</span>
                        {item.when && <span class="font-mono">{item.when}</span>}
                      </p>
                      <p class="rm-pop-about">{item.about}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </article>
      ))
    }
  </div>
</section>

<script>
  // Drawing the waves, rippling them and placing the popovers load only as the roadmap nears the viewport
  // (roadmap.ts is its own chunk). Until then, and without JS, the waves are drawn and still, and popovers
  // open in the middle of the window.
  const roadmap = document.querySelector<HTMLElement>('[data-roadmap]')
  if (roadmap) {
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        near.disconnect()
        import('./roadmap').then((m) => m.initRoadmap(roadmap))
      },
      { rootMargin: '400px 0px' },
    )
    near.observe(roadmap)
  }
</script>
