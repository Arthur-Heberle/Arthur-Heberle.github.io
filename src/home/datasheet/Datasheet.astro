---
// Datasheet — the spine's second paragraph and notes, rebuilt as an electronic component's
// datasheet (Arthur's brief, 2026-10-02). Copy is verbatim from that brief. A rounded panel (the frame and
// the section rules went on 2026-10-24: spacing separates the parts), mono labels in sentence case, and a small
// ruled title block in the corner, the one line left. Real headings, a list for Features and two real
// tables, so a screen reader can move through it. datasheet.ts fades the parts in.
import NoteDrawing from '../spine/NoteDrawing.astro'
import { getLang } from '../../shared/i18n/lang'
import { getChangelog } from '../../shared/i18n/content'
import { text } from './text'

const lang = getLang(Astro)
const t = text[lang]

// rev. YYYY.MM, from the newest changelog entry (the same order the Changelog section uses)
const entries = await getChangelog(lang)
const newest = entries.slice().sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id))[0]
const rev = newest.data.date.slice(0, 7).replace('-', '.')
---

<section class="datasheet" aria-labelledby="datasheet-heading" data-datasheet>
  <div class="ds-frame">
    <!-- the paper: a sheet lying on the page, turned a little (desktop). Only this layer is rotated, so the text
         stays unrotated and crisp. Decoration: aria-hidden. -->
    <div class="ds-paper" aria-hidden="true"></div>
    <header class="ds-head" data-ds-part>
      <h2 id="datasheet-heading" class="ds-title">{t.title}</h2>
      <div class="ds-titleblock" role="group" aria-label={t.sheetInfo}>
        <p class="tb-top">Arthur Heberle</p>
        <p class="tb-sheet">{t.sheet}</p>
        <p class="tb-sheet">{t.rev} {rev}</p>
      </div>
    </header>

    <div class="ds-section" data-ds-part>
      <h3 class="ds-label">{t.featuresHeading}</h3>
      <ul class="ds-features" role="list">
        {
          t.features.map(([claim, proof]) => (
            <li class="ds-feature">
              <span class="ds-claim">{claim}</span>
              <span class="ds-proof text-small text-graphite-2">{proof}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ds-tables">
      <div class="ds-section" data-ds-part>
        <h3 class="ds-label">{t.characteristicsHeading}</h3>
        <table class="ds-table">
          <thead>
            <tr><th scope="col">{t.parameter}</th><th scope="col">{t.value}</th></tr>
          </thead>
          <tbody>
            {
              t.characteristics.map(({ id, k, v }) => (
                <tr data-ds-row={id === 'languages' ? 'languages' : undefined}>
                  {id === 'languages' ? (
                    <th scope="row">
                      <span class="ds-label-cell">
                        <span>{k}</span>
                        <span class="ds-art ds-art-row">
                          <NoteDrawing kind="languages" />
                        </span>
                      </span>
                    </th>
                  ) : (
                    <th scope="row">{k}</th>
                  )}
                  <td>{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="ds-section" data-ds-part>
        <h3 class="ds-label">{t.conditionsHeading}</h3>
        <table class="ds-table">
          <thead>
            <tr><th scope="col">{t.parameter}</th><th scope="col">{t.value}</th></tr>
          </thead>
          <tbody>
            {t.conditions.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>

    <div class="ds-section" data-ds-part>
      <h3 class="ds-label">{t.effectsHeading}</h3>
      <p class="ds-effects">
        {t.chess}<span class="ds-art ds-art-inline" data-ds-hover><NoteDrawing kind="chess" /></span>
        {t.guitar}<span class="ds-art ds-art-inline" data-ds-hover><NoteDrawing kind="guitar" /></span>
      </p>
    </div>

    <div class="ds-section" data-ds-part>
      <h3 class="ds-label">{t.orderHeading}</h3>
      <p class="ds-order"><a href="mailto:a.gp.heberle@gmail.com">a.gp.heberle@gmail.com</a></p>
    </div>
  </div>
</section>

<script>
  import { initDatasheet } from './datasheet'
  initDatasheet()
</script>
