---
import '../styles/global.css'

interface Props {
  title: string
  noindex?: boolean
}

const { title, noindex = false } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Only the display face is preloaded: it's what paints the hero line, and it's
         the only one of the four self-hosted fonts on the critical path. crossorigin
         is mandatory even though the request is same-origin. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/archivo-expanded-500-latin.woff2"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
