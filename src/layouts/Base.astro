---
import '../styles/global.css'

interface Props {
  title: string
  noindex?: boolean
}

const { title, noindex = false } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Must run before first paint, or a CSS-revealed filter bar (step 05) would flash
         and vanish for a no-JS visitor — that's exactly the layout shift step 06 gates
         on. is:inline stops Astro from bundling/deferring it. Reused by steps 07-13. -->
    <script is:inline>
      document.documentElement.classList.add('js')
      // Step 12's flash guard: motion.ts (a deferred module script) can't set the hero
      // word spans to opacity:0 before first paint, so without this a visitor sees the
      // heading appear, vanish, then animate in. Opt in only when the sequence will
      // actually run — not already played this session, not reduced motion — so a
      // no-JS visitor or a repeat visit never hides the heading in the first place.
      // The 1.5s failsafe (docs/motion-spec.md's own 1.6s ceiling, minus headroom) is
      // what keeps the heading readable even if GSAP fails to load; motion.ts removes
      // the class itself, synchronously, well before that in the success path.
      try {
        if (
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
          sessionStorage.getItem('hero-played') !== '1'
        ) {
          var root = document.documentElement
          root.classList.add('hero-pending')
          setTimeout(function () {
            root.classList.remove('hero-pending')
          }, 1500)
        }
      } catch (e) {}
    </script>
    <!-- The display face is preloaded: it's what paints the hero line, and it's on the
         critical path. crossorigin is mandatory even though the request is same-origin. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/archivo-expanded-500-latin.woff2"
    />
    <!-- Step 06: Archivo 400 also preloaded. Measured CLS 0.006 without this — the hero
         name line (Archivo 500, but 400 shares a layout-affecting font family swap)
         reflows when Archivo 400 finishes loading elsewhere above the fold. Diverges
         from design-spec.md §5's "preload the display face only", written before step 02
         chose self-hosting; §10's "no layout shift" is the higher constraint and this is
         its gate step. Archivo 500 and IBM Plex Mono are below the fold or non-critical
         and stay swap-only. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/archivo-400-latin.woff2"
    />
  </head>
  <body>
    <!-- Every page rendering this layout must give its main content element id="main":
         this is what the skip link lands on. -->
    <a class="skip" href="#main">Skip to main content</a>
    <slot />
    <!-- The single scroll authority (docs/motion-spec.md): one Lenis instance, one
         gsap.ticker hook, registered plugins, and the matchMedia scaffold steps 08-13
         fill in. A module script defers on its own, so no is:inline / defer needed here
         — unlike the head script above, this one is allowed to be bundled and deferred. -->
    <script>
      import '../scripts/motion.ts'
    </script>
  </body>
</html>
