---
// The Braille cell — design-spec.md §9's "strongest piece on the site". Ships in its
// final, fully-drawn state (motion-spec.md's initial-state pattern). Every cell draws all
// six positions as an outline well, raised or not — the empty ones are the
// annotated-technical-drawing concept doing its job, and they never animate. The raised
// dots sit on top of their wells, grouped per letter (`.braille-cell`), and motion.ts's
// setPieceBraille() hides them at load and then loops them the way the device works: one
// character at a time, its pins rising out of their holes, holding, dropping, then the
// next. A failed GSAP load leaves this already-complete diagram, the same pattern
// Rule.astro/Tick.astro/MarginNote.astro already use.
//
// The controls beside the word are a cross-shaped pad (Arthur, 2026-09-29): up restarts
// the word, left slower, right faster, down pause/play, the current speed in the middle.
// They are the device's own buttons, and they are what makes a looping animation acceptable (WCAG 2.2.2: anything
// moving for more than 5s needs a way to pause it). Shown only where the loop runs (JS,
// >=768px, motion allowed — type.css); absent everywhere else, where the cell is static.
//
// The dot pattern is never hand-drawn: brailleCells() (src/lib/braille.ts) derives every
// circle's position from the word itself, so this component cannot render anything but
// an accurate translation of `word` (implementation-plan.md step 13: "the dots must
// correspond to the word actually being spelled").
//
// The text row beneath is the "text version rendering alongside" design-spec.md §9 asks
// for. Each letter ships twice, stacked on one grid cell: a --graphite-2 base (always
// legible, never moved — motion-spec.md's tier-1 rule that scrubbed text is never used)
// and a --signal duplicate at opacity:0, crossfaded on with its own cell's dots.
// Same technique step 10 used for .leader-hi, for the same reason: a colour swap can't
// transition, so the highlight is a second element instead.
import { brailleCells } from '../lib/braille'

interface Props {
  word: string
}
const { word } = Astro.props
const cells = brailleCells(word)
const viewWidth = cells.length * 6
---

<div class="braille-stage" data-braille={word} data-anim>
  <div class="braille-word">
  <svg
    class="braille-cells"
    viewBox={`0 0 ${viewWidth} 9`}
    role="img"
    aria-labelledby="braille-title braille-desc"
  >
    <title id="braille-title">Braille cell spelling {word}</title>
    <desc id="braille-desc">
      A six-dot Braille cell for each letter of "{word}", its pins rising one letter at a time, on a loop.
    </desc>
    {
      cells.map((cell) => (
        <g class="braille-cell">
          {cell.dots.map((dot) => (
            <circle
              cx={dot.x}
              cy={dot.y}
              r="0.55"
              class="braille-well"
              fill="none"
              stroke="var(--color-line)"
              stroke-width="0.15"
            />
          ))}
          {cell.dots
            .filter((dot) => dot.raised)
            .map((dot) => (
              <circle cx={dot.x} cy={dot.y} r="0.75" class="braille-dot" fill="var(--color-measure)" />
            ))}
        </g>
      ))
    }
  </svg>
  <div class="braille-letters text-h3" style={`grid-template-columns: repeat(${cells.length}, 1fr)`}>
    {
      cells.map((cell) => (
        <span class="braille-letter">
          <span class="braille-letter-base font-sans font-medium text-graphite-2">
            {cell.letter.toUpperCase()}
          </span>
          <span class="braille-letter-hi font-sans font-medium text-signal" aria-hidden="true">
            {cell.letter.toUpperCase()}
          </span>
        </span>
      ))
    }
  </div>
  </div>
  <div class="braille-controls" role="group" aria-label="Braille animation">
    <button
      type="button"
      class="control feedback dpad-up"
      data-braille-restart
      aria-label="Restart the word"
      title="Restart the word"
    >
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2.5 2.5 V9.5" />
        <path class="solid" d="M10 2.5 L4 6 L10 9.5 Z" />
      </svg>
    </button>
    <button
      type="button"
      class="control feedback dpad-left"
      data-braille-speed="-1"
      aria-label="Slower"
      title="Slower"
    >
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2.5 6 H9.5" />
      </svg>
    </button>
    <p class="filter-count dpad-centre" aria-live="polite" data-braille-rate>1×</p>
    <button
      type="button"
      class="control feedback dpad-right"
      data-braille-speed="1"
      aria-label="Faster"
      title="Faster"
    >
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2.5 6 H9.5 M6 2.5 V9.5" />
      </svg>
    </button>
    <button
      type="button"
      class="control feedback dpad-down"
      data-braille-toggle
      aria-label="Pause"
      title="Pause"
    >
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path class="solid" d="M1.5 3 L6 6 L1.5 9 Z" />
        <path d="M8 3 V9 M10.5 3 V9" />
      </svg>
    </button>
  </div>
</div>
