---
// One margin note: its rendered body from the `notes` collection, a back-link to the
// spine marker that points at it, and a leader-line SVG in its own final, drawn state.
// Step 10 adds motion (motion.ts's tier1Leaders scrubs both paths below) and the
// marker<->note highlight: a second, --signal-coloured path stacked on the construction
// line, crossfaded in on opacity when Spine.astro's script sets [data-linked] on this
// <aside> — a stroke-colour swap can't transition (motion-spec.md's property rule), so
// the highlight is a duplicate element instead.
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'notes'>
  marker: number
  /** Position among the notes sharing one rail margin (docs/motion-spec.md's 60ms sibling
   *  stagger, on top of the 200ms lag behind the paragraph). Defaults to 0 — a rail with
   *  only one note omits this prop entirely. */
  sibling?: number
}
const { entry, marker, sibling = 0 } = Astro.props
const { Content } = await render(entry)
// 0.2 + 0.06 * sibling, but toFixed keeps the rendered attribute clean: 0.2 + 0.06 * 2 is
// 0.32000000000000006 in binary floating point.
const delay = (0.2 + 0.06 * sibling).toFixed(2)
---

<aside class="note" id={`note-${entry.id}`} data-anim data-delay={delay}>
  <svg class="leader" viewBox="0 0 32 24" preserveAspectRatio="none" aria-hidden="true">
    <!-- Two identical paths: the construction line, and the highlight that crossfades
         over it when this note is [data-linked]. A duplicate rather than a stroke swap
         because motion-spec.md forbids transitioning color/stroke; opacity is legal.
         Both are drawn by the same tier 1 tween (motion.ts's tier1Leaders), so the
         highlight can never be drawn ahead of the line underneath it. vector-effect stays
         for constant 1px stroke width — but unlike .tick, motion.ts bypasses DrawSVGPlugin
         for this element too: measured live (not assumed from the viewBox math), this
         box's proportionality has enough subpixel rounding slop to make DrawSVGPlugin warn
         even though #rule path's much larger non-proportional gap is absent (see
         motion.ts's tier1Leaders). -->
    <path
      class="leader-base"
      d="M0 4 H18 L32 12"
      fill="none"
      stroke="var(--color-line)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
    <path
      class="leader-hi"
      d="M0 4 H18 L32 12"
      fill="none"
      stroke="var(--color-signal)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
  </svg>
  <div class="note-text text-small text-graphite-2">
    <a class="feedback marker" href={`#marker-${entry.id}`} aria-label={`back to reference ${marker}`}>
      {marker}
    </a>
    <strong class="font-sans font-medium text-graphite">{entry.data.label}</strong> —
    <Content />
  </div>
</aside>
