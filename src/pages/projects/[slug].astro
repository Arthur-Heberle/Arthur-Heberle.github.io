---
// Project page routing — one route per id in PROJECT_PAGES (src/projects/projects.ts), the one
// list this file and the home bench both read so a bench link can never point
// at a route that doesn't exist. getStaticPaths() is required here: astro.config.mjs
// declares no `output` key, so the default static output applies. The page itself is
// src/projects/ProjectRoute.astro, shared with the Portuguese route.
import type { CollectionEntry } from 'astro:content'
import ProjectRoute from '../../projects/ProjectRoute.astro'
import { PROJECT_PAGES } from '../../projects/projects'
import { getProjects } from '../../shared/i18n/content'

export async function getStaticPaths() {
  const projects = await getProjects('en')
  const pages = projects.filter((entry) => (PROJECT_PAGES as readonly string[]).includes(entry.id))
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'projects'>
}
const { entry } = Astro.props
---

<ProjectRoute entry={entry} />
